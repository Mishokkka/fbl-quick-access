<div class="injury-row special-addiction-row" data-row-kind="item" data-item-id="{{itemId}}" data-order="{{order}}">
  <div class="injury-header">
    {{#if editable}}<span class="fblec-drag-handle" title="{{localize 'FBLEC.UI.Drag'}}"><i class="fas fa-grip-vertical"></i></span>{{/if}}
    <div class="injury-title-block addiction-title-block">
      <i class="fas fa-pills collapse-icon addiction-collapse-toggle" title="{{localize 'FBLEC.UI.ToggleDescription'}}"></i>
      <img class="injury-img" src="{{img}}" title="{{name}}" />
      <span class="condition-name addiction-name-display">{{name}}</span>
    </div>
    <div class="addiction-controls">
      {{#if editable}}
        <select class="addiction-severity-select" title="{{localize 'FBLEC.Addiction.Severity'}}" {{#if pending}}disabled{{/if}}>
          {{#each severityOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      {{/if}}
      <span class="addiction-status" title="{{statusTitle}}">{{statusText}}</span>
    </div>
    {{#if editable}}<button type="button" class="delete-condition delete-injury addiction-delete-btn" title="{{localize 'FBLEC.Addiction.Delete'}}"><i class="fas fa-trash"></i></button>{{/if}}
  </div>
  <div class="addiction-workflow {{#if pending}}is-pending{{/if}}">
    <p class="addiction-modifier-status">{{modifierText}}</p>
    <p class="addiction-daily-status" aria-live="polite">{{morningText}} {{rollText}}</p>
    {{#if editable}}
      <div class="addiction-actions">
        <button type="button" class="addiction-btn addiction-morning" {{#if morningDisabled}}disabled{{/if}}><i class="fas fa-sun"></i> {{localize 'FBLEC.Addiction.Morning'}}</button>
        {{#if pending}}
          <button type="button" class="addiction-btn addiction-advance"><i class="fas fa-check"></i> {{localize 'FBLEC.Addiction.EnduranceSuccess'}}</button>
          <button type="button" class="addiction-btn addiction-failure"><i class="fas fa-times"></i> {{localize 'FBLEC.Addiction.EnduranceFailure'}}</button>
        {{/if}}
        <button type="button" class="addiction-btn addiction-relapse" title="{{localize 'FBLEC.Addiction.Relapse'}}"><i class="fas fa-syringe"></i> {{localize 'FBLEC.Addiction.TakeDose'}}</button>
      </div>
    {{/if}}
  </div>
  <div class="injury-desc">{{{effect}}}</div>
</div>

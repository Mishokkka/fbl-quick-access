<div class="injury-row special-heat-row heat-level-{{value}}" data-row-kind="item" data-item-id="{{itemId}}" data-order="{{order}}" data-heat-level="{{value}}">
  <div class="injury-header">
    {{#if editable}}<span class="fblec-drag-handle" title="{{localize 'FBLEC.UI.Drag'}}"><i class="fas fa-grip-vertical"></i></span>{{/if}}
    <div class="injury-title-block heat-title-block condition-details-toggle" role="button" tabindex="0" aria-expanded="false" title="{{localize 'FBLEC.UI.ToggleDescription'}}">
      <i class="fas fa-chevron-right collapse-icon heat-collapse-toggle" aria-hidden="true"></i>
      <img class="injury-img" src="{{img}}" title="{{name}}" />
      <span class="condition-name heat-name-display">{{name}}</span>
    </div>
    <div class="heat-controls">
      {{#if editable}}<button type="button" class="heat-btn heat-minus" title="{{localize 'FBLEC.Heat.Minus'}}" aria-label="{{localize 'FBLEC.Heat.Minus'}}">−</button>{{/if}}
      <div class="heat-meter" title="{{localize 'FBLEC.Heat.Level'}}">{{{dots}}}</div>
      <input class="heat-input" type="text" value="{{value}}/{{max}}" title="{{localize 'FBLEC.Heat.EditLevel'}}" aria-label="{{localize 'FBLEC.Heat.EditLevel'}}" {{#unless editable}}readonly{{/unless}}>
      {{#if editable}}
        <button type="button" class="heat-btn heat-plus" title="{{localize 'FBLEC.Heat.Plus'}}" aria-label="{{localize 'FBLEC.Heat.Plus'}}">+</button>
      {{/if}}
      <button type="button" class="heat-btn heat-check" title="{{localize 'FBLEC.Heat.Rules'}}" aria-label="{{localize 'FBLEC.Heat.Rules'}}" aria-expanded="false"><i class="fas fa-book-open" aria-hidden="true"></i></button>
    </div>
    {{#if editable}}<button type="button" class="delete-condition delete-injury addiction-delete-btn" title="{{localize 'FBLEC.Heat.Delete'}}"><i class="fas fa-trash"></i></button>{{/if}}
  </div>
  <div class="injury-desc heat-desc">
    <div class="heat-summary">
      <span class="heat-summary-title">{{levelLabel}}:</span>
      <span>{{levelSummary}}</span>
      <span class="heat-consequence">{{levelConsequence}}</span>
    </div>
    <p>{{localize 'FBLEC.Heat.WorkflowHint'}}</p>
    <p>{{localize 'FBLEC.Heat.DamageRules'}}</p>
    <p><b>{{localize "FBLEC.Heat.Increase"}}:</b> {{localize "FBLEC.Heat.IncreaseText"}}</p>
    <p><b>{{localize "FBLEC.Heat.Decrease"}}:</b> {{localize "FBLEC.Heat.DecreaseText"}}</p>
    {{#if effect}}<hr><div class="heat-source-effect">{{{effect}}}</div>{{/if}}
  </div>
</div>
